{
  "manifest_version": 3,
  "name": "Code Coloring",
  "version": "1.0.1",
  "description": "Automatically highlight local source files. Choose a language or pretty-print JSON for viewing, entirely offline.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "action": {
    "default_title": "Code Coloring",
    "default_popup": "popup.html"
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["file:///*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
